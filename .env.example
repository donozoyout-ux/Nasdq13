# NASDAQ Signal Bot Configuration
# Copy to .env and fill in your API keys

# Telegram (Required)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# News APIs (Free tiers)
NEWSAPI_KEY=""           # newsapi.org - 100 req/day
ALPHA_VANTAGE_KEY=""     # alphavantage.co - 25 req/day
FINNHUB_KEY=""           # finnhub.io - 60 req/min (optional)

# AI Report (OPTIONAL - boşsa sistem ücretsiz kurallı AI ile rapor üretir)
# Tanımlarsanız haftalık/günlük raporlar gerçek bir LLM ile yazılır
OPENAI_API_KEY=""

# Weekly/Daily report scheduling (Türkiye saati)
# Haftalık rapor: hafta içi gün 0=Pzt..6=Paz, saat/dakika
WEEKLY_REPORT_DAY=6
WEEKLY_REPORT_HOUR=20
WEEKLY_REPORT_MINUTE=0
# Günlük brifing: Pzt-Cuma
DAILY_BRIEF_DAY_START=0
DAILY_BRIEF_DAY_END=4
DAILY_BRIEF_HOUR=15
DAILY_BRIEF_MINUTE=30

# Trading Settings
SYMBOLS="NQ=F,ES=F,YM=F,RTY=F"  # Comma-separated Yahoo Finance symbols
TIMEFRAMES="1m,5m,15m,1h"       # Analysis timeframes
SCAN_INTERVAL_SECONDS=60        # How often to scan (seconds)

# Signal Thresholds
STRONG_BUY_THRESHOLD=75
BUY_THRESHOLD=60
WATCH_THRESHOLD=45
STRONG_SELL_THRESHOLD=-75
SELL_THRESHOLD=-60

# Technical Analysis Parameters
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2
EMA_SHORT=9
EMA_MEDIUM=21
EMA_LONG=50
VOLUME_SMA_PERIOD=20
VOLUME_SPIKE_MULTIPLIER=2.0
ATR_PERIOD=14
DONCHIAN_PERIOD=20

# News Sentiment
NEWS_LOOKBACK_HOURS=6
NEWS_KEYWORD_BOOST_MAX=30
NEWS_HIGH_IMPACT_MULTIPLIER=3

# Risk Management
ATR_SL_MULTIPLIER=1.5
ATR_TP1_MULTIPLIER=2.0
ATR_TP2_MULTIPLIER=3.0
MAX_SIGNALS_PER_HOUR=10
SIGNAL_COOLDOWN_MINUTES=15

# Market Hours (UTC)
MARKET_OPEN_UTC="13:30"    # 9:30 AM ET
MARKET_CLOSE_UTC="20:00"   # 4:00 PM ET
PRE_MARKET_START_UTC="12:00"
AFTER_HOURS_END_UTC="22:00"

# State Persistence
STATE_FILE="data/bot_state.json"
LOG_LEVEL="INFO"
LOG_FILE="logs/bot.log"

# Render / Deployment
RENDER_SERVICE=true
HEALTH_CHECK_PORT=8080